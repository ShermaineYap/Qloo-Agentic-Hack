# Copy to .env for local runs (never commit .env). On Railway/Render set these as secrets.

# Event-issued Qloo credential (or run `qloo setup --qloo` locally instead).
QLOO_API_KEY=

# One LLM provider. Anthropic is the default.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ...or any OpenAI-compatible endpoint (OpenAI, Gemini's OpenAI API, OpenRouter).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# Optional
# PORT=3000
# QLOO_MOCK=1              # sample data only, no Qloo calls
# QLOO_CONCURRENCY=3       # parallel Qloo calls
# PLAN_LIMIT_PER_HOUR=12   # new tours per visitor per hour on the public demo
