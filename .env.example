# Copy to .env for local runs (never commit .env). On Railway/Render set these as secrets.

# Event-issued Qloo credential and the hackathon API server from Qloo's email.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com

# One LLM provider (the first one set wins: Anthropic, then Gemini, then OpenAI-compatible).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash   # falls back to other Gemini models when one is busy
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ...or any OpenAI-compatible endpoint (OpenAI, OpenRouter).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# Optional
# PORT=3000
# QLOO_MOCK=1              # sample data only, no Qloo calls
# QLOO_CONCURRENCY=3       # parallel Qloo calls
# PLAN_LIMIT_PER_HOUR=12   # new tours per visitor per hour on the public demo
