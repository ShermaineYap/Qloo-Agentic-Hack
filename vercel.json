{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{data/**,server/qloo-tools.schema.json}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__p=api/:path*" },
    { "source": "/healthz", "destination": "/api/index?__p=healthz" },
    { "source": "/tour/:id", "destination": "/index.html" }
  ]
}
